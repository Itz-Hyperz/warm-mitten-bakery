<footer class="site-footer">
    <div class="container py-4">
        <div class="row align-items-center">
            <div class="col-md-6 text-center text-md-start mb-3 mb-md-0">
                <img src="/assets/logo.png" alt="<%= business.name %>" class="footer-logo mb-2">
                <p class="mb-0 small">&copy; <%= new Date().getFullYear() %> <%= business.name %>. All rights reserved. | Website by <a style="text-decoration: none; color: inherit;" href="https://boss.software">Boss Software</a></p>
            </div>
            <div class="col-md-6 text-center text-md-end">
                <p class="mb-1"><i class="fa-solid fa-location-dot me-2"></i><%= business.location %></p>
                <p class="mb-1"><i class="fa-solid fa-phone me-2"></i><%= business.phone %></p>
                <p class="mb-0"><i class="fa-solid fa-envelope me-2"></i><%= business.email %></p>
            </div>
        </div>
    </div>
</footer>
